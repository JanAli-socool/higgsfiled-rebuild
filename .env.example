# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Models: "fal" for real generations, "mock" for placeholder outputs (no cost)
MODEL_PROVIDER=mock
FAL_KEY=

# Public base URL for provider webhooks (leave empty on localhost; jobs are then synced by polling)
PUBLIC_URL=

# Optional per-kind overrides of MODEL_PROVIDER: fal | cloudflare | pollinations | huggingface | kie | mock
IMAGE_PROVIDER=
VIDEO_PROVIDER=

# Cloudflare Workers AI (free daily quota): account id + API token with Workers AI permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face ZeroGPU Space for image-to-video (free). Without a token the server's IP gets
# ~2 GPU-min/day (~1–2 clips); a free account's read token gives ~5 min/day (~4 clips).
HF_TOKEN=
HF_VIDEO_SPACE=zerogpu-aoti/wan2-2-fp8da-aoti-faster

# Google Veo 3.1 image-to-video through KIE (paid credits, VIDEO_PROVIDER=kie): 8 s clips at 720p with sound.
# Tier: veo3_lite (default, ~30 KIE credits a clip) | veo3_fast | veo3
KIE_API_KEY=
KIE_VEO_MODEL=

# Stripe (test mode). Without a secret key the Buy buttons are switched off.
# The webhook secret is only needed once deployed (or with `stripe listen` locally):
# credits are also granted when the buyer returns from Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
